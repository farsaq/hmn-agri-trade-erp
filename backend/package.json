{
  "name": "hmn-agri-trade-backend",
  "version": "5.7.8",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "test": "node --test --test-reporter=spec",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "verify": "npm run check && npm run lint && npm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:security": "npm audit --audit-level=high",
    "migrate:customers": "node src/scripts/migrateCustomers.js",
    "migrate:suppliers": "node src/scripts/migrateSuppliers.js",
    "migrate:products": "node src/scripts/migrateProducts.js",
    "migrate:warehouses-units": "node src/scripts/migrateWarehousesUnits.js",
    "migrate:transactions": "node src/scripts/migrateTransactions.js",
    "migrate:financial-hardening": "node src/scripts/migrateFinancialHardening.js",
    "migrate:accounting": "node src/scripts/migrateAccounting.js",
    "migrate:accounting-enterprise": "node src/scripts/migrateAccountingEnterprise.js",
    "reconcile": "node src/scripts/reconcileDatabase.js",
    "security:smoke": "node src/scripts/securitySmoke.js",
    "release:check": "npm run verify && npm run audit:security",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec",
    "performance:audit": "node src/scripts/auditPerformance.js",
    "test:unit": "node --test tests test",
    "test:ci": "node --test --test-reporter=spec",
    "test:coverage:ci": "node --test --experimental-test-coverage --test-reporter=spec",
    "smoke:production": "node src/scripts/productionSmoke.js",
    "load:smoke": "node src/scripts/loadSmoke.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.2",
    "bwip-js": "^4.11.4",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "image-size": "^2.0.4",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "multer": "^2.4.0",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "readdir-glob": "^3.0.0",
    "redis": "^5.12.1",
    "socket.io": "^4.8.4",
    "stripe": "^17.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
