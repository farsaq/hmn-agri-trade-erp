# Core runtime
NODE_ENV=development
PORT=5000
TRUST_PROXY=1
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/hmn_agri_trade
JWT_ISSUER=hmn-agri-trade-api
JWT_AUDIENCE=hmn-agri-trade-web
JWT_SECRET=replace_with_at_least_32_random_characters
CLIENT_URL=http://localhost:5173,http://localhost:5174
LOG_LEVEL=debug
LOG_TO_FILES=true
LOG_TO_CONSOLE=true
LOG_DIRECTORY=logs
LOG_RETENTION_DAYS=30
METRICS_TOKEN=
RUNTIME_CONFIG_PATH=
JSON_BODY_LIMIT=2mb
COMPRESSION_THRESHOLD_BYTES=1024

# Initial admin seed
ADMIN_EMAIL=admin@hmn.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Authentication and email
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HMN Agri Trade <no-reply@example.com>

# AI provider
AI_API_URL=
AI_API_KEY=
AI_MODEL=
OPENAI_API_KEY=

# Cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_FILE_SIZE_MB=15
CLOUDINARY_MAX_FILES=20
CLOUDINARY_DEFAULT_QUALITY=auto:good
CLOUDINARY_DEFAULT_WIDTH=1600
CLOUDINARY_DEFAULT_HEIGHT=900
CLOUDINARY_MIN_IMAGE_WIDTH=200
CLOUDINARY_MIN_IMAGE_HEIGHT=200
CLOUDINARY_MAX_IMAGE_WIDTH=12000
CLOUDINARY_MAX_IMAGE_HEIGHT=12000
CLOUDINARY_FOLDER_QUOTA_MB=2048
CLOUDINARY_ARCHIVE_AFTER_DAYS=180
CLOUDINARY_SIGNED_UPLOAD_TTL_SECONDS=300
CLOUDINARY_REQUIRE_UPLOAD_TOKEN=true
CLOUDINARY_ACCOUNT_QUOTA_MB=0
VIRUS_SCAN_WEBHOOK_URL=
VIRUS_SCAN_API_KEY=
VIRUS_SCAN_TIMEOUT_MS=15000

# Messaging and integrations
REDIS_URL=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=HMN
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
INTEGRATION_API_KEY=

# Google Drive backup
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
BACKUP_AUTO_ENABLED=false
BACKUP_AUTO_PROVIDER=local
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MINIMUM=5

# Payment gateways
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Performance and database tuning
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SLOW_QUERY_MS=250
CACHE_ENABLED=false
CACHE_DEFAULT_TTL_SECONDS=60

COMPANY_NAME=HMN Agri Trade
COMPANY_PHONE=
COMPANY_LOCATION=Hala, Sindh, Pakistan
