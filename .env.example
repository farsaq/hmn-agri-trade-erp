# Copy this file to .env.docker for local Docker development
# or to .env.production for a production deployment.
BACKEND_PORT=5000
FRONTEND_PORT=5173
HTTP_PORT=80
MONGO_PORT=27017
REDIS_PORT=6379
MONGO_DATABASE=hmn_agri_trade
REDIS_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PUBLIC_APP_URL=http://localhost
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Performance and database tuning
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SLOW_QUERY_MS=250
CACHE_ENABLED=false
CACHE_DEFAULT_TTL_SECONDS=60
